# LLM & Embedding Settings (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Agent LLM — used by Orchestrator, Synthesizer, run_cypher, suggest_fix
OLLAMA_LLM_MODEL=qwen3:4b

# Embedding model — used by retriever for vector search
# Use the exact tag from: ollama list
OLLAMA_EMBED_MODEL=qwen3-embed-0.6b

# Neo4j Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# Logging
LOG_LEVEL=INFO
